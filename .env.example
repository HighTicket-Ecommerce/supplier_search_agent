# Shared secret for the UI and backend; required for every endpoint except /health.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPPLIER_API_KEY=
# Optional password for the Streamlit page.
SUPPLIER_UI_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2-2025-12-11
APIFY_TOKEN=
# Optional overrides for another model: standard USD per million tokens.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# OPENAI_MAX_OUTPUT_TOKENS=1800
# SUPPLIER_JOB_DB=var/research_jobs.sqlite
# SUPPLIER_REFERENCE_DIR=var/references
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_SCHEME=http
